# WagonEye v4 environment overrides.
#
# Copy to deploy/wagon-eye.env and edit as needed, then point the systemd unit's
# EnvironmentFile= at it.  EVERY variable is optional -- unset means the
# pre-migration default shown below, so an empty file reproduces the original
# behaviour exactly.  Uncomment only what you need to change.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no quotes
# needed unless the value contains spaces.

# ---- Filesystem paths (relative values resolve against the repo root) -------
# WAGONEYE_WORKSPACE_ROOT=/data/wagon_eye/batch_outputs
# WAGONEYE_MODELS_DIR=/data/wagon_eye/models
# WAGONEYE_RECON_MODELS_DIR=/data/wagon_eye/models/reconstruction
# WAGONEYE_FEAT_MODELS_DIR=/data/wagon_eye/models/features
# WAGONEYE_LOCAL_INPUTS_DIR=/data/wagon_eye/local_inputs
# WAGONEYE_LOG_DIR=/var/log/wagon_eye
# WAGONEYE_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# ---- Inference device -------------------------------------------------------
# auto-detect if unset: CUDA when available, else CPU.  Force with:
# WAGONEYE_DEVICE=cuda
# WAGONEYE_DEVICE=cpu

# ---- CPU throughput ---------------------------------------------------------
# YOLO frames per batch (amortizes CPU per-call overhead).  Benchmarked fastest
# at 24 on CPU (door 2.4x, damage 1.45x; 32 was slower).  1 = single-frame,
# bit-identical to the pre-batch pipeline.  Outputs are unchanged except <=1e-3
# px box-coordinate jitter from BLAS reduction order (state/conf/class identical).
# WAGONEYE_INFER_BATCH=24
#
# Per-camera override of the above (V4 has this as `detection_batch_size` in
# configs/cameras/*.yaml).  Unset -> the global value.
# WAGONEYE_INFER_BATCH_RIGHT_UP=24
# WAGONEYE_INFER_BATCH_LEFT_UP=24
# WAGONEYE_INFER_BATCH_RIGHT_UP_TOP=16
# WAGONEYE_INFER_BATCH_LEFT_UP_TOP=16
#
# Intra-op CPU threads (default: all cores).  On a single-service `--source raw`
# box, leave 1-2 cores free: the ExtractionManager runs YOLO in a background
# thread while Stage 3 runs YOLO in the main thread, and both claiming every core
# makes both slower.  e.g. 14 on a 16-vCPU c6i.4xlarge.
# WAGONEYE_TORCH_THREADS=14

# ---- Stage-1 detector batching (OPT-IN, default off) ------------------------
# Stage 1 runs the gap detector over EVERY frame of all four full videos -- the
# single largest CPU cost in a batch, and unbatched by default.  Batching it is
# the biggest available throughput win.
#
# It defaults to 1 (the original path) DELIBERATELY: Stage 1 produces the SEALED
# CANONICAL wagon count, GW ids and boundaries, and CPU batching can shift box
# coordinates by <=1e-3 px (BLAS reduction order).  That is far below any
# threshold here, but it deserves evidence rather than assumption.
#
# To adopt it: run the same clips at 1 and at 16, and confirm total_wagons, the
# GW ids and each wagon's start/end_frame_master are unchanged.  Only the raw
# detector call is batched -- frame order, filters, NMS and the Kalman tracking
# are per-frame exactly as before.
# WAGONEYE_STAGE1_INFER_BATCH=16

# ---- Raw-detections benchmark mode (NON-PRODUCTION) -------------------------
# When true, bypass every post-inference REJECTION filter (door: geometric prior
# + identity merge; damage: area/edge-zone + cross-track dedup + loaded-wagon +
# non-wagon skips) so the detector's raw conf-thresholded predictions flow
# through.  The trained models + confidence thresholds are unchanged.  Leave
# unset/false for production -- this changes detections on purpose.
# WAGONEYE_RAW_DETECTIONS=false

# ---- S3 buckets -- THE V4 BUCKET SET (all defaults; nothing to set) ---------
# These defaults ARE the buckets the V4 Train-Inspection-Engine uses
# (Train-Inspection-Engine/configs/cameras/*.yaml + configs/combiner.yaml), so an
# empty env file already points at the existing production topology:
#
#   raw CCTV            biro-wagon-raw-video-copy/<camera_folder>
#   trimmed clips       biro-wagon-pre-processed-video-copy/<camera_folder>
#   detected videos     biro-wagon-processed-video-copy/<camera_folder>
#   reports/evidence    biro-wagon-report-biro-copy/train_batch/<batch_key>/
#   combined report     biro-combined-report-copy
#   models              s3://wagon-eye-models/ (flat, bucket root)
#
# camera_folder is one of camera_CCTV_HZBN_DHN_{2_RIGHT_UP,1_LEFT_UP,5_RIGHT_TOP,
# 6_LEFT_TOP} (core.constants.CAMERA_S3_FOLDER -- the single source of truth).
#
# WAGONEYE_S3_REGION=ap-south-1
# WAGONEYE_S3_OUTPUT_BUCKET=biro-wagon-report-biro-copy
# WAGONEYE_S3_TRAIN_BATCH_PREFIX=train_batch
# WAGONEYE_S3_STATE_KEY=master_runner/processed_batches.json
# WAGONEYE_S3_RAW_VIDEO_BUCKET=biro-wagon-raw-video-copy
# WAGONEYE_S3_TRIMMED_VIDEO_BUCKET=biro-wagon-pre-processed-video-copy
# WAGONEYE_S3_COMBINED_REPORT_BUCKET=biro-combined-report-copy
#
# Per-camera mirror of the overlay/annotated videos (V4 detected_video_bucket).
# Set to empty to skip the mirror -- the train_batch/ archive copy is unaffected.
# WAGONEYE_S3_DETECTED_VIDEO_BUCKET=biro-wagon-processed-video-copy
#
# The overlay renderer writes an mp4v file, which is bulky and not broadly
# browser-playable, so it is re-encoded to H.264 under a size cap before the
# mirror (same as V4's compress_video).  Needs ffmpeg on PATH; if ffmpeg is
# missing or the encode fails, the original is published rather than nothing.
# WAGONEYE_COMPRESS_DETECTED_VIDEO=true
# WAGONEYE_DETECTED_VIDEO_MAX_MB=50
# WAGONEYE_DETECTED_VIDEO_CRF=26

# ---- Models: source + S3 sync -----------------------------------------------
# PRIMARY SOURCE: the .pt weights ship WITH THE CODE via Git LFS
# (.gitattributes: `*.pt filter=lfs`).  On a fresh box:  `git lfs pull`.
# Startup VERIFIES every required model and fails fast, naming any missing file.
#
# A model missing locally is fetched from the V4 model bucket, which keeps every
# .pt at the bucket ROOT (hence prefix empty + layout flat):
#     s3://wagon-eye-models/<file>
# Set WAGONEYE_MODELS_S3_LAYOUT=nested if your mirror instead organises them as
#     s3://<bucket>/<prefix>/{reconstruction,features,extraction}/<file>
# IAM needs s3:GetObject on those keys.
#
# COLLISION GUARD: side_classification.pt and top_classification.pt each exist in
# BOTH models/reconstruction/ and models/extraction/ with DIFFERENT weights.  A
# flat bucket cannot tell them apart, so they are NEVER auto-downloaded -- put
# them in place yourself (see models/extraction/README.md).
# WAGONEYE_MODELS_S3_LAYOUT=flat
#   reconstruction: right_up_gap.pt left_up_gap.pt top_gap.pt side_classification.pt
#   features:       door_state.pt loaded.pt damage.pt wagon_number_update.pt
#                   (wagon_number_update.pt is the V4 right_up plate detector;
#                    the older wagon_id_counting.pt is accepted as a fallback)
#   extraction:     side_classification.pt top_classification.pt
#                   (ONLY when WAGONEYE_PIPELINE_SOURCE=raw -- see
#                    models/extraction/README.md; DIFFERENT weights from the
#                    same-named reconstruction model)
# Defaults to the V4 model bucket at its root.  Set the bucket to empty to
# disable auto-sync entirely and require the Git-LFS weights.
# WAGONEYE_MODELS_S3_BUCKET=wagon-eye-models
# WAGONEYE_MODELS_S3_PREFIX=

# ---- S3 (source video discovery for --auto polling) -------------------------
# REQUIRED for continuous mode: comma-separated prefix(es) under the input
# bucket that hold the camera videos.  If empty, --auto finds nothing.
#
# These must point at the TRIMMED clips (already-extracted train passes) --
# either produced by the standalone wagon-eye-extraction.service OR by the
# inline producer (WAGONEYE_INLINE_EXTRACTION=1 below).  The values below are
# the production trimmed bucket + the four per-camera prefixes the extractor
# uploads to (see driver._CAMERA_CONFIG).
# WAGONEYE_S3_INPUT_BUCKET=biro-wagon-pre-processed-video-copy
# WAGONEYE_S3_INPUT_PREFIXES=camera_CCTV_HZBN_DHN_2_RIGHT_UP,camera_CCTV_HZBN_DHN_1_LEFT_UP,camera_CCTV_HZBN_DHN_5_RIGHT_TOP,camera_CCTV_HZBN_DHN_6_LEFT_TOP

# ---- Pipeline source: WHAT this pipeline consumes ---------------------------
# 'trimmed' (default): the input prefixes already hold trimmed train clips; this
#                      process is a pure consumer (two-service topology, or a
#                      separate producer / manual uploads).
# 'raw'              : only raw CCTV exists; this process owns an ExtractionManager
#                      that discovers raw video, detects train completion, runs
#                      the train extractor, and produces the trimmed clips before
#                      consuming them.  ONE `master_runner --auto` process then
#                      performs the whole pipeline: raw -> extract -> inspect ->
#                      report -> deliver.  (--source raw overrides this at runtime.)
# WAGONEYE_PIPELINE_SOURCE=raw
#
# When source=raw, the ExtractionManager reuses the SAME train_extraction code as
# the standalone service and reads the SAME WAGONEYE_EXTRACTION_* settings
# (raw/trimmed buckets default to production; classify models resolve from
# WAGONEYE_EXTRACTION_MODELS_DIR).  Drop the EXTRACTION classify models
# (side_classification.pt, top_classification.pt) there -- these are the
# extractor's empty_track/wagon/engine classifiers, NOT the Stage-1 recon models:
# WAGONEYE_EXTRACTION_MODELS_DIR=/opt/wagon_eye_v4/models/extraction
# WAGONEYE_EXTRACTION_POLL_INTERVAL=60

# ---- OCR engine (wagon numbers, RIGHT_UP only) ------------------------------
# 'rekognition' (DEFAULT): AWS Rekognition DetectText, matching the V4
#     Train-Inspection-Engine.  Per wagon, the plate detections are grouped into
#     bands; for each band THREE crops are stacked on one vertical sheet and sent
#     in ONE DetectText call, and the best VALID 11-digit line wins.  Needs boto3
#     + IAM `rekognition:DetectText`.  Startup refuses to run if boto3 is absent.
# 'easyocr': the local model (no network, no per-call cost, lower accuracy).
#     Also used automatically as a fallback if a Rekognition client cannot be
#     constructed at run time.
# WAGONEYE_OCR_ENGINE=rekognition
#
# Region for Rekognition (defaults to WAGONEYE_S3_REGION).  DetectText is not
# available in every region -- pin it here if your bucket region lacks it.
# WAGONEYE_REKOGNITION_REGION=ap-south-1
#
# Hard ceiling on DetectText calls per wagon.  Each call is one billed request,
# so this is the per-wagon cost cap.  V4 tries at most 2 sheets per band
# (primary + fallback); 4 leaves room for a second band on a noisy wagon.
# WAGONEYE_REKOGNITION_MAX_CALLS_PER_WAGON=4
#
# Frame gap (in frames) that separates two plate bands within one wagon
# (V4 right_up.yaml: wagon_number_gap_tolerance).
# WAGONEYE_OCR_GAP_TOLERANCE=8
#
# NOTE the RIGHT_UP plate detector is models/features/wagon_number_update.pt (the
# V4 right_up model).  The older wagon_id_counting.pt is still accepted as a
# fallback when wagon_number_update.pt is absent.

# ---- Per-camera inspection JSON (dashboard feed) ----------------------------
# One exact-V4-schema *_inspection.json per camera angle is generated at
# finalization and POSTed to the ingest API.  ON by default.
# WAGONEYE_DASHBOARD_INGEST_ENABLED=true
#
# `version` inside the document.  The dashboard picks its TAB from this value,
# so it is deliberately left at the pre-existing production value: v1 -> V1 tab.
# Set to v4 to be byte-identical to the V4 engine's own output (and to land in
# the v4 tab).  CHANGE THIS ONLY WITH THE DASHBOARD TEAM.
# WAGONEYE_INSPECTION_VERSION=v1
#
# Document `camera_id` form.  Unset (default) it FOLLOWS the version, because the
# two must agree or the dashboard cannot match a document to a camera:
#   v1 -> camera_CCTV_HZBN_DHN_2_RIGHT_UP  (what the live V1 feed has always sent)
#   v4 -> CCTV_HZBN_DHN_2_RIGHT_UP         (V4-exact)
# Set it to pin one form regardless of version.  The ingest API payload's
# camera_id is always the full prefixed form either way.
# WAGONEYE_INSPECTION_STRIP_CAMERA_PREFIX=
#
# S3 folder per camera, inside the inspection bucket.  VERIFIED against each
# camera's own INSPECTION_JSON_FOLDER in the old per-camera pipeline that feeds
# this dashboard -- note the TOP cameras are Right_Top / Left_Top (capital T, no
# "up"), NOT Right_up_top / Left_up_top.  Full key:
#   <folder>/<YYYY-MM-DD>/<raw_basename>_inspection.json   (05:00 IST day rule)
# Override only if the dashboard's layout has since changed:
# WAGONEYE_INSPECTION_FOLDERS={"RIGHT_UP":"Right_up","LEFT_UP":"Left_up","RIGHT_UP_TOP":"Right_Top","LEFT_UP_TOP":"Left_Top"}
#
# WAGONEYE_INSPECTION_JSON_BUCKET=ankit-version-1-prod
# WAGONEYE_INSPECTION_MODEL_ID=model-v3
#
# WHICH RECEIVER -- this decides which dashboard sees the report.  The V1 and V4
# receivers are DIFFERENT HOSTS; a report delivered to one is not visible on the
# other.  Default is the V1 receiver (what this feed has always used), so an
# upgrade never silently repoints live traffic.
#   v1 -> ms-pnr-location-notification-api.suvidhaen.com/cctv-receiver/inspections/ingest
#   v4 -> cctv-wagon-api.suvidhaen.com/inspections/ingest
#         + cctv-wagon-uat-api.suvidhaen.com/inspections/ingest   (V4 posts to both)
# Comma-separated; the shorthands v1 / v4 expand as above.  Set
# WAGONEYE_INSPECTION_VERSION=v4 alongside to land in the v4 tab.
# WAGONEYE_INSPECTION_INGEST_API_URLS=v4
#
# Single-endpoint override (used when the list above is unset):
# WAGONEYE_INSPECTION_INGEST_API_URL=https://ms-pnr-location-notification-api.suvidhaen.com/cctv-receiver/inspections/ingest

# ---- Local-disk retention ---------------------------------------------------
# A batch is ~3 GB on disk, of which ~80% is wagon_cache/ (per-wagon JPEGs) plus
# downloads/ (the source clips).  Both are pure intermediates -- every durable
# artifact (global_state, wagon_states, reports, evidence, processed_videos) is
# already mirrored to S3 by the time this runs.
#
# ON by default: delete wagon_cache/, downloads/ and archive/ once a batch reaches
# a SUCCESSFUL terminal state.  A FAILED batch always keeps them for diagnosis,
# and an ACTIVE batch is never touched (a late camera still reads the cache when
# regenerating its report).  Set false to keep everything.
# WAGONEYE_PRUNE_INTERMEDIATES=true
#
# Additionally delete WHOLE batch directories older than N days (0 = off, the
# default).  Active batches are skipped regardless of age.  With intermediate
# pruning on, a finished batch is only tens of MB, so this is mostly about
# reclaiming reports/evidence copies that already live in S3.
# WAGONEYE_BATCH_RETENTION_DAYS=14

# ---- Report microservice + email --------------------------------------------
# WAGONEYE_UPLOAD_API_URL=https://reports-api.suvidhaen.com/api/upload-pdf
# WAGONEYE_EMAIL_API_URL=https://ms-pnr-location-notification-api.suvidhaen.com/notification_microservice/send-email
# WAGONEYE_PRODUCT_NAME=CCTV-WagonEye-CombinedReports
# WAGONEYE_EMAIL_RECEIVER=ops@example.com
# WAGONEYE_EMAIL_RECEIVER_CC=lead@example.com,qa@example.com

# ---- AWS credentials --------------------------------------------------------
# Prefer an EC2 instance IAM role (no keys needed).  If you must use static
# keys, set them here (or better, in ~/.aws/credentials):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=ap-south-1

# ---- Incremental (asynchronous-camera) lifecycle ----------------------------
# The four camera videos for one train do NOT arrive together.  The pipeline
# waits for the RIGHT_UP master, opens a short support-fusion window (armed the
# moment RIGHT_UP arrives) so support cameras can improve Stage-1 gap recovery,
# then SEALS an immutable GlobalTrainState from RIGHT_UP + whatever support is
# present.  Late cameras attach features to the sealed wagons WITHOUT re-running
# Stage 1 or renumbering wagons.  Defaults below reproduce sane production behaviour.
#
# How long (from first-seen) to wait for the RIGHT_UP master before it is "late":
# WAGONEYE_MASTER_WAIT_MINUTES=10
# Short window AFTER RIGHT_UP arrives to collect support cameras, then seal.
# When it expires we seal from RIGHT_UP + present support -- we do NOT wait for
# the final deadline.
# WAGONEYE_SUPPORT_FUSION_WAIT_MINUTES=3
# Hard close (from first-seen): still-missing cameras become CAMERA_MISSING_FINAL
# and the batch finalizes as COMPLETED_PARTIAL.  NOT an implicit master deadline.
# Must be >= SUPPORT_FUSION_WAIT_MINUTES.
# WAGONEYE_FINAL_CAMERA_WAIT_MINUTES=30
#
# If RIGHT_UP never arrives: the batch stays WAITING_FOR_MASTER until the hard
# deadline, then closes FAILED_NO_GLOBAL_STATE (no report, no email).  LEFT_UP
# fallback master is EXPERIMENTAL and disabled -- side_classification.pt is a
# RIGHT_UP model and is unvalidated on LEFT_UP:
# WAGONEYE_ENABLE_LEFT_UP_FALLBACK_MASTER=false
#
# Interim (pre-closure) reports are regenerated on disk as cameras arrive but are
# LOCAL-ONLY by default: exactly one upload + one email happens at closure.
# WAGONEYE_GENERATE_INTERIM_REPORTS=true
# WAGONEYE_UPLOAD_INTERIM_REPORTS=false   # requires GENERATE_INTERIM_REPORTS=true
# WAGONEYE_EMAIL_INTERIM_REPORTS=false    # requires GENERATE_INTERIM_REPORTS=true
#
# A camera that shows up AFTER a batch is terminal is logged and ignored by
# default; the sealed report is never reopened:
# WAGONEYE_LATE_CAMERA_POLICY=IGNORE
#
# Active-batch scheduler poll cadence (seconds) and manifest S3 prefix (empty ->
# train_batch/<key>/manifest.json):
# WAGONEYE_ACTIVE_BATCH_POLL_INTERVAL=60
# WAGONEYE_MANIFEST_S3_PREFIX=

# ---- Extraction lookback window ---------------------------------------------
# How far back (minutes) a sweep considers raw clips, judged by the S3 object's
# LastModified.  Default 10: starting the pipeline means "process trains from NOW",
# not "grind forward through months of history".
#
# A raw bucket holds months of CCTV, and the dedup ledger lives in the checkout --
# so on a fresh install the sweep would otherwise begin at the OLDEST clip.  (That
# is exactly what happened on the first production run: it started on a February
# clip.)
#
# TRADE-OFF: clips older than the window are skipped PERMANENTLY.  If the service
# is down longer than this, video from the gap is never extracted.  Raise it to
# cover expected downtime; set 0 to process everything the dedup ledger has not
# already handled.
# WAGONEYE_EXTRACTION_LOOKBACK_MINUTES=10
