# WagonEye v4 environment overrides.
#
# Copy to deploy/wagon-eye.env and edit as needed, then point the systemd unit's
# EnvironmentFile= at it.  EVERY variable is optional -- unset means the
# pre-migration default shown below, so an empty file reproduces the original
# behaviour exactly.  Uncomment only what you need to change.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no quotes
# needed unless the value contains spaces.

# ---- Filesystem paths (relative values resolve against the repo root) -------
# WAGONEYE_WORKSPACE_ROOT=/data/wagon_eye/batch_outputs
# WAGONEYE_MODELS_DIR=/data/wagon_eye/models
# WAGONEYE_RECON_MODELS_DIR=/data/wagon_eye/models/reconstruction
# WAGONEYE_FEAT_MODELS_DIR=/data/wagon_eye/models/features
# WAGONEYE_LOCAL_INPUTS_DIR=/data/wagon_eye/local_inputs
# WAGONEYE_LOG_DIR=/var/log/wagon_eye
# WAGONEYE_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# ---- Inference device -------------------------------------------------------
# auto-detect if unset: CUDA when available, else CPU.  Force with:
# WAGONEYE_DEVICE=cuda
# WAGONEYE_DEVICE=cpu

# ---- CPU throughput ---------------------------------------------------------
# YOLO frames per batch (amortizes CPU per-call overhead).  Benchmarked fastest
# at 24 on CPU (door 2.4x, damage 1.45x; 32 was slower).  1 = single-frame,
# bit-identical to the pre-batch pipeline.  Outputs are unchanged except <=1e-3
# px box-coordinate jitter from BLAS reduction order (state/conf/class identical).
# WAGONEYE_INFER_BATCH=24
# Intra-op CPU threads (default: all cores).
# WAGONEYE_TORCH_THREADS=16

# ---- Raw-detections benchmark mode (NON-PRODUCTION) -------------------------
# When true, bypass every post-inference REJECTION filter (door: geometric prior
# + identity merge; damage: area/edge-zone + cross-track dedup + loaded-wagon +
# non-wagon skips) so the detector's raw conf-thresholded predictions flow
# through.  The trained models + confidence thresholds are unchanged.  Leave
# unset/false for production -- this changes detections on purpose.
# WAGONEYE_RAW_DETECTIONS=false

# ---- S3 (output/archive + report state) -------------------------------------
# WAGONEYE_S3_REGION=ap-south-1
# WAGONEYE_S3_OUTPUT_BUCKET=biro-wagon-report-biro-copy
# WAGONEYE_S3_TRAIN_BATCH_PREFIX=train_batch
# WAGONEYE_S3_STATE_KEY=master_runner/processed_batches.json

# ---- Models: source + optional S3 sync --------------------------------------
# PRODUCTION CONVENTION: the .pt weights ship WITH THE CODE.  The old pipeline
# kept them inside each camera folder; this repo tracks them via Git LFS
# (.gitattributes: `*.pt filter=lfs`).  On a fresh box:  `git lfs pull`.
# There is NO production model bucket -- startup only VERIFIES the required
# models are present and fails fast (naming any missing file) if not.
#
# OPTIONAL S3 auto-sync (only if YOU host the .pt files in S3):  set the bucket
# below and startup will download any MISSING model from
#     s3://<WAGONEYE_MODELS_S3_BUCKET>/<WAGONEYE_MODELS_S3_PREFIX>/reconstruction/<file>
#     s3://<WAGONEYE_MODELS_S3_BUCKET>/<WAGONEYE_MODELS_S3_PREFIX>/features/<file>
# into the local model dirs (IAM needs s3:GetObject on these keys).
#   reconstruction: right_up_gap.pt left_up_gap.pt top_gap.pt side_classification.pt
#   features:       door_state.pt loaded.pt damage.pt wagon_id_counting.pt
# No production default -- leave empty to use the Git-LFS weights.
# WAGONEYE_MODELS_S3_BUCKET=
# WAGONEYE_MODELS_S3_PREFIX=models

# ---- S3 (source video discovery for --auto polling) -------------------------
# REQUIRED for continuous mode: comma-separated prefix(es) under the input
# bucket that hold the camera videos.  If empty, --auto finds nothing.
#
# These must point at the TRIMMED clips (already-extracted train passes) --
# either produced by the standalone wagon-eye-extraction.service OR by the
# inline producer (WAGONEYE_INLINE_EXTRACTION=1 below).  The values below are
# the production trimmed bucket + the four per-camera prefixes the extractor
# uploads to (see driver._CAMERA_CONFIG).
# WAGONEYE_S3_INPUT_BUCKET=biro-wagon-pre-processed-video-copy
# WAGONEYE_S3_INPUT_PREFIXES=camera_CCTV_HZBN_DHN_2_RIGHT_UP,camera_CCTV_HZBN_DHN_1_LEFT_UP,camera_CCTV_HZBN_DHN_5_RIGHT_TOP,camera_CCTV_HZBN_DHN_6_LEFT_TOP

# ---- Pipeline source: WHAT this pipeline consumes ---------------------------
# 'trimmed' (default): the input prefixes already hold trimmed train clips; this
#                      process is a pure consumer (two-service topology, or a
#                      separate producer / manual uploads).
# 'raw'              : only raw CCTV exists; this process owns an ExtractionManager
#                      that discovers raw video, detects train completion, runs
#                      the train extractor, and produces the trimmed clips before
#                      consuming them.  ONE `master_runner --auto` process then
#                      performs the whole pipeline: raw -> extract -> inspect ->
#                      report -> deliver.  (--source raw overrides this at runtime.)
# WAGONEYE_PIPELINE_SOURCE=raw
#
# When source=raw, the ExtractionManager reuses the SAME train_extraction code as
# the standalone service and reads the SAME WAGONEYE_EXTRACTION_* settings
# (raw/trimmed buckets default to production; classify models resolve from
# WAGONEYE_EXTRACTION_MODELS_DIR).  Drop the EXTRACTION classify models
# (side_classification.pt, top_classification.pt) there -- these are the
# extractor's empty_track/wagon/engine classifiers, NOT the Stage-1 recon models:
# WAGONEYE_EXTRACTION_MODELS_DIR=/opt/wagon_eye_v4/models/extraction
# WAGONEYE_EXTRACTION_POLL_INTERVAL=60

# ---- Report microservice + email --------------------------------------------
# WAGONEYE_UPLOAD_API_URL=https://reports-api.suvidhaen.com/api/upload-pdf
# WAGONEYE_EMAIL_API_URL=https://ms-pnr-location-notification-api.suvidhaen.com/notification_microservice/send-email
# WAGONEYE_PRODUCT_NAME=CCTV-WagonEye-CombinedReports
# WAGONEYE_EMAIL_RECEIVER=ops@example.com
# WAGONEYE_EMAIL_RECEIVER_CC=lead@example.com,qa@example.com

# ---- AWS credentials --------------------------------------------------------
# Prefer an EC2 instance IAM role (no keys needed).  If you must use static
# keys, set them here (or better, in ~/.aws/credentials):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=ap-south-1

# ---- OCR (AWS Rekognition) ---------------------------------------------------
# Wagon numbers are read by Rekognition DetectText on the RIGHT_UP master only.
# The instance role (or the keys above) must allow `rekognition:DetectText`.
#
# Rekognition bills PER IMAGE.  The pipeline keeps that bounded by grouping a
# wagon's plate detections into bands and stacking three frames of a band onto
# ONE contact sheet -- so a wagon costs one call, two if the fallback triplet is
# needed, never one per frame.  The sheet is persisted as
# evidence/<GW_n>/ocr/RIGHT_UP/number_sheet.jpg (byte-identical to the image
# posted), which is what the dashboard's `ocr_frame_s3_url` points at.
#
# Region for the Rekognition endpoint (defaults to WAGONEYE_S3_REGION):
# WAGONEYE_REKOGNITION_REGION=ap-south-1
# Frames of dropout tolerated inside one detection band (default 8).  Larger =
# fewer, longer bands = fewer API calls but coarser plate separation.
# WAGONEYE_OCR_BAND_GAP_TOLERANCE=8

# ---- Incremental (asynchronous-camera) lifecycle ----------------------------
# The four camera videos for one train do NOT arrive together.  The pipeline
# waits for the RIGHT_UP master, opens a short support-fusion window (armed the
# moment RIGHT_UP arrives) so support cameras can improve Stage-1 gap recovery,
# then SEALS an immutable GlobalTrainState from RIGHT_UP + whatever support is
# present.  Late cameras attach features to the sealed wagons WITHOUT re-running
# Stage 1 or renumbering wagons.  Defaults below reproduce sane production behaviour.
#
# How long (from first-seen) to wait for the RIGHT_UP master before it is "late":
# WAGONEYE_MASTER_WAIT_MINUTES=10
# Short window AFTER RIGHT_UP arrives to collect support cameras, then seal.
# When it expires we seal from RIGHT_UP + present support -- we do NOT wait for
# the final deadline.
# WAGONEYE_SUPPORT_FUSION_WAIT_MINUTES=3
# Hard close (from first-seen): still-missing cameras become CAMERA_MISSING_FINAL
# and the batch finalizes as COMPLETED_PARTIAL.  NOT an implicit master deadline.
# Must be >= SUPPORT_FUSION_WAIT_MINUTES.
# WAGONEYE_FINAL_CAMERA_WAIT_MINUTES=30
#
# If RIGHT_UP never arrives: the batch stays WAITING_FOR_MASTER until the hard
# deadline, then closes FAILED_NO_GLOBAL_STATE (no report, no email).  LEFT_UP
# fallback master is EXPERIMENTAL and disabled -- side_classification.pt is a
# RIGHT_UP model and is unvalidated on LEFT_UP:
# WAGONEYE_ENABLE_LEFT_UP_FALLBACK_MASTER=false
#
# Interim (pre-closure) reports are regenerated on disk as cameras arrive but are
# LOCAL-ONLY by default: exactly one upload + one email happens at closure.
# WAGONEYE_GENERATE_INTERIM_REPORTS=true
# WAGONEYE_UPLOAD_INTERIM_REPORTS=false   # requires GENERATE_INTERIM_REPORTS=true
# WAGONEYE_EMAIL_INTERIM_REPORTS=false    # requires GENERATE_INTERIM_REPORTS=true
#
# A camera that shows up AFTER a batch is terminal is logged and ignored by
# default; the sealed report is never reopened:
# WAGONEYE_LATE_CAMERA_POLICY=IGNORE
#
# Active-batch scheduler poll cadence (seconds) and manifest S3 prefix (empty ->
# train_batch/<key>/manifest.json):
# WAGONEYE_ACTIVE_BATCH_POLL_INTERVAL=60
# WAGONEYE_MANIFEST_S3_PREFIX=
